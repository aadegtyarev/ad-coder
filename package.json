{
  "name": "ad-coder",
  "version": "0.129.0",
  "description": "A small, explicit multi-provider agent harness: roles over pi-agent-core, per-role/step cost ledger, in-house context management, and a plan->[security]->code<->review pipeline.",
  "license": "MIT",
  "author": "Alexander Degtyarev <adegtyarev.ap@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadegtyarev/ad-coder.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "ad-coder": "./bin/ad-coder.mjs"
  },
  "files": [
    "bin",
    "src",
    "prompts",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check src test scripts evals",
    "check:fix": "biome check --write src test scripts evals",
    "check:release": "bun run scripts/check-release.ts",
    "check:version": "bun run scripts/check-version.ts",
    "check:docs": "bun run scripts/check-docs.ts",
    "check:conflict-markers": "bun run scripts/check-conflict-markers.ts",
    "check:prices": "bun run scripts/check-prices.ts",
    "stamp:check": "bun run src/cli.ts stamp check",
    "calibration:score": "bun run scripts/calibration-score.ts",
    "calibration:check-reviewer": "bun run evals/scorers/reviewer-hidden-regression.ts",
    "calibration:check-skill-trigger": "bun run evals/scorers/skill-trigger.ts",
    "calibration:materialize": "bun run scripts/calibration-materialize.ts",
    "calibration:check-pipeline": "bun run evals/scorers/pipeline-repair-regressions.ts",
    "smoke:artifact": "bun run scripts/artifact-smoke.ts",
    "setup:hooks": "git config core.hooksPath scripts/hooks",
    "format": "biome format --write src test",
    "lint": "biome lint src test",
    "start": "bun run src/cli.ts",
    "calibration:corpus": "bun run evals/runner/corpus.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [],
  "engines": {
    "bun": ">=1.3.13"
  }
}
