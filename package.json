{
  "name": "ad-coder",
  "version": "0.2.1",
  "private": true,
  "description": "A small, explicit multi-provider agent harness: roles over pi-agent-core, per-role/step cost ledger, in-house context management, and a plan->[security]->code<->review pipeline.",
  "license": "MIT",
  "author": "Alexander Degtyarev <adegtyarev.ap@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadegtyarev/ad-coder.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "ad-coder": "./src/cli.ts"
  },
  "files": [
    "src",
    "prompts",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check src test scripts",
    "check:fix": "biome check --write src test scripts",
    "check:release": "bun run scripts/check-release.ts",
    "check:docs": "bun run scripts/check-docs.ts",
    "calibration:score": "bun run scripts/calibration-score.ts",
    "calibration:check-reviewer": "bun run evals/scorers/reviewer-hidden-regression.ts",
    "calibration:materialize": "bun run scripts/calibration-materialize.ts",
    "smoke:artifact": "bun run scripts/artifact-smoke.ts",
    "format": "biome format --write src test",
    "lint": "biome lint src test",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": []
}
